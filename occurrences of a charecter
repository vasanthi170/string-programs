#counting the number of occurences of charecter
s   = 'happy'
res =  ''
for ch in s:
    if ch not in res:
        res += ch
for ch in res:
    print(f'{ch}={s.count(ch)}')

#counting the number of occurences of charecter
s = 'happy'
d = {}
for ch in s:
    if ch not in d:
        d[ch] = 1
    else:
        d[ch] += 1
for keys,values in d.items():
    print(f'{keys} = {values}')
